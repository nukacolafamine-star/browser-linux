#!/bin/sh
set -eu
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
# Alpine's initramfs mounts the real root read-only. Normal OpenRC boot would
# remount it; this minimal init path must perform that step itself.
mount -o remount,rw /
mkdir -p /dev/pts /run /tmp /var/log
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mountpoint -q /run || mount -t tmpfs -o mode=755 tmpfs /run
chmod 1777 /tmp
hostname browser-linux-wayland
printf '\nBROWSER_LINUX_GUEST_BOOT arch=%s kernel=%s\n' "$(uname -m)" "$(uname -r)"
printf 'Rendering: Weston Pixman on virtual DRM; guest GPU acceleration unavailable.\n'

# Virtio modules belong to this guest kernel. They do not touch the host OS.
modprobe virtio_gpu || true
modprobe virtio_rng || true
modprobe evdev || true
modprobe usbhid || true
modprobe i8042 || true
modprobe atkbd || true
modprobe psmouse || true
/sbin/udevd --daemon
# Only desktop devices need udev properties. Triggering every virtual PCI/ACPI
# device also loads unused storage and nested-virtualization drivers, which is
# costly under instruction translation. These input properties are still real
# udev rules and must pass the independent graphical-input acceptance test.
udevadm trigger --action=add --subsystem-match=drm
udevadm trigger --action=add --subsystem-match=input
udevadm trigger --action=add --subsystem-match=hidraw
udevadm settle --timeout=20 || true
/usr/local/sbin/browser-exchange > /var/log/browser-exchange.log 2>&1 &

# Keep serial usable even if a graphics prerequisite is missing.
case " $(cat /proc/cmdline) " in
  *' browser.graphics=off '*) printf 'BROWSER_LINUX_GRAPHICS_DISABLED\n' ;;
  *) /usr/local/sbin/browser-weston > /var/log/browser-weston.log 2>&1 & ;;
esac
cat /etc/motd
printf 'BROWSER_LINUX_SERIAL_READY\n'
