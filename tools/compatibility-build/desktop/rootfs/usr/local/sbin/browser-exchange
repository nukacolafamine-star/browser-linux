#!/bin/sh
# Mounts the browser's private file exchange (a virtio-9p share of in-tab
# memory, never host files) and watches it for a shutdown request.
set -u
console() { printf '%s\n' "$*" > /dev/ttyS0; }
mkdir -p /mnt/browser
if ! mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144,cache=none browser /mnt/browser 2>/dev/null; then
  console 'BROWSER_LINUX_EXCHANGE_UNAVAILABLE'
  exit 0
fi
chmod 1777 /mnt/browser 2>/dev/null || true
mkdir -p /mnt/browser/.control
chmod 700 /mnt/browser/.control
printf 'browser-linux-exchange-v1\n' > /mnt/browser/.control/ready
console 'BROWSER_LINUX_EXCHANGE_READY mount=/mnt/browser'
while sleep 1; do
  if [ -f /mnt/browser/.control/shutdown ]; then
    rm -f /mnt/browser/.control/shutdown
    console 'BROWSER_LINUX_SHUTDOWN_REQUESTED'
    sync
    /sbin/poweroff
    exit 0
  fi
done
