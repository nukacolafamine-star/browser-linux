#!/bin/sh
# The desktop user's session: Weston with Xwayland for X11 programs.
set -eu
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=weston
export LIBSEAT_BACKEND=seatd SEATD_SOCK=/run/seatd.sock
export LANG=C.UTF-8 XCURSOR_SIZE=24
mkdir -p "$HOME/.local/state"
exec dbus-run-session -- weston --backend=drm --renderer="${BROWSER_RENDERER:-pixman}" \
  --shell=desktop-shell.so --socket=wayland-0 --idle-time=0 --continue-without-input \
  --log="$HOME/.local/state/weston.log"
